// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int     @id   @default(autoincrement())
  username      String  @unique
  email         String
  preferences   UserPreference?
  password      String
  messages      Message[]
  trackedFlights TrackedFlight[]
}

model UserPreference {
  id                          Int         @id   @default(autoincrement())
  userId                      Int         @unique
  user                        User        @relation(fields: [userId], references: [id])
  budgetTier                  Int
  cuisine                     String?
  activityCategory            String?
  defaultCity                 String?
  cityWeight                  Float?     @default(0.4)
  budgetWeight                Float?     @default(0.3)
  cuisineWeight               Float?     @default(0.15)
  activityWeight              Float?     @default(0.15)
  hotelPriceWeight            Float?     @default(0.4)
  hotelRatingWeight           Float?     @default(0.3)
  hotelReviewWeight           Float?     @default(0.3)
  restaurantRatingWeight      Float?     @default(0.5)
  restaurantReviewWeight      Float?     @default(0.5)
  thingsToDoRatingWeight      Float?     @default(0.5)
  thingsToDoReviewWeight      Float?     @default(0.5)
}

model TrackedFlight {
  id            Int     @id    @default(autoincrement())
  user          User    @relation(fields: [userId], references: [id])
  userId        Int
  airline       String
  flightNumber  String?
  departure     String
  arrival       String
  flightDate    DateTime?
  trackedAt     DateTime @default(now())

  @@index([userId])
}

model Message {
  id          Int     @id   @default(autoincrement())
  content     String
  user        User    @relation(fields: [userId], references: [id] )
  userId      Int
}

model Hotel {
  id          Int     @id    @default(autoincrement())
  city        String
  state       String
  name        String
  rating      Float?
  imageUrl    String? @map("image_url")
  reviewCount Int?    @map("review_count")
  description String?
  price       Int

  @@unique([name, city, state])

  @@index([city])
  @@index([state])
  @@index([rating])
}

model ThingsToDo {
  id          Int     @id    @default(autoincrement())
  name        String
  city        String
  state       String
  rating      Float?
  imageUrl    String? @map("image_url")
  reviewCount Int?    @map("review_count")
  description String?
  location    String?
  category    String?

  @@unique([name, city, state])

  @@index([city])
  @@index([state])
  @@index([rating])
}

model Restaurant {
  id          Int     @id    @default(autoincrement())
  name        String
  city        String
  state       String
  rating      Float?
  imageUrl    String? @map("image_url")
  category    String?
  reviewCount Int?    @map("review_count")
  description String?

  @@unique([name, city, state])

  @@index([city])
  @@index([state])
  @@index([rating])
  @@index([category])
}
